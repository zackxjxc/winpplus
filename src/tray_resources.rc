#include <windows.h>
#include "app_version.h"
#include "app_identity.h"
#include "winpplus_resources.generated.h"
101 ICON WINPPLUS_ICON_DARK
102 ICON WINPPLUS_ICON_LIGHT

1 VERSIONINFO
FILEVERSION WINPPLUS_VERSION_TUPLE
PRODUCTVERSION WINPPLUS_VERSION_TUPLE
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", WINPPLUS_FILE_DESCRIPTION
            VALUE "FileVersion", WINPPLUS_VERSION_STRING
            VALUE "ProductName", WINPPLUS_PRODUCT_NAME
            VALUE "InternalName", WINPPLUS_PRODUCT_NAME
            VALUE "OriginalFilename", "WinPPlus.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 zackxjxc"
            VALUE "ProductVersion", WINPPLUS_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
